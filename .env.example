# =============================================================
# SoundPub Dashboard - Environment Variables Example
# =============================================================
# File ini adalah REFERENSI / DOKUMENTASI.
#
# - Di Lovable Cloud: `.env` di-inject otomatis untuk VITE_SUPABASE_*.
#   JANGAN edit manual.
# - Di self-hosted (Supabase Docker + VPS): salin file ini menjadi
#   `.env` di root project frontend, isi sesuai deployment sendiri.
# - Build Secrets (VITE_*) yang bukan supabase harus di-set di
#   Workspace Settings -> Build Secrets (Lovable) atau di CI/CD
#   (self-hosted) sebelum `bun run build`.
# - Backend / edge function secrets (tanpa prefix VITE_) TIDAK
#   masuk ke .env frontend. Lihat bagian bawah file ini + ENV-DOCS.md.
# =============================================================


# -------------------------------------------------------------
# 1) Supabase (frontend client)
# -------------------------------------------------------------
# Lovable Cloud (auto):
VITE_SUPABASE_PROJECT_ID="opkvvdgnhhopkkeaokzo"
VITE_SUPABASE_URL="https://opkvvdgnhhopkkeaokzo.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<auto-generated-by-lovable>"

# Self-hosted contoh:
# VITE_SUPABASE_PROJECT_ID="soundpub-self"
# VITE_SUPABASE_URL="https://api.yourdomain.com"
# VITE_SUPABASE_PUBLISHABLE_KEY="<ANON_KEY dari supabase/docker .env>"


# -------------------------------------------------------------
# 2) SSO ICCN (frontend - keycloak-js)
# -------------------------------------------------------------
VITE_SSO_BASE_URL="https://sso.iccn.or.id"
# Realm: staging=playground, production=PORTALICCN
VITE_SSO_REALM="playground"
VITE_SSO_CLIENT_ID="soundpub"
# true = auto-redirect ke ICCN jika silent SSO gagal
VITE_SSO_AUTO_REDIRECT="false"

# CATATAN: ICCN mengembalikan callback lewat URL fragment
# (`/auth#code=...&state=...`), bukan query string. Jangan ubah
# `redirect_uri` dari `${origin}/auth`.


# -------------------------------------------------------------
# 3) Google Analytics 4 (opsional)
# -------------------------------------------------------------
# VITE_GA4_MEASUREMENT_ID="G-XXXXXXXXXX"


# =============================================================
# CLOUD / EDGE FUNCTION SECRETS (BACKEND)
# =============================================================
# Variable berikut TIDAK boleh masuk ke .env frontend.
#
# - Lovable Cloud: set via Lovable -> Cloud -> Secrets
# - Supabase self-hosted (CLI):  supabase secrets set KEY=value
# - Supabase self-hosted (Docker): tambahkan ke `supabase/docker/.env`
#   di bagian functions.env / composed environment.
#
# --- Supabase internal (auto di Lovable Cloud; wajib manual di self-host) ---
#   SUPABASE_URL              = https://api.yourdomain.com
#   SUPABASE_ANON_KEY         = <ANON_KEY>
#   SUPABASE_SERVICE_ROLE_KEY = <SERVICE_ROLE_KEY>   # RAHASIA
#   SUPABASE_DB_URL           = postgres://postgres:PASS@db:5432/postgres
#   SUPABASE_JWKS             = <auto/optional untuk verify JWT>
#   SUPABASE_PUBLISHABLE_KEY  = <sama dengan ANON_KEY di self-host>
#
# --- SSO ICCN (Edge Function `sso-login`) ---
#   SSO_REALM_URL         = https://sso.iccn.or.id/realms/PORTALICCN
#                         atau .../realms/playground (staging)
#   SSO_CLIENT_ID         = soundpub
#   ICCN_MEDIA_LABEL_ID   = <UUID profil "ICCN Media">
#                           SELECT id FROM profiles
#                           WHERE email = 'halo.iccn@gmail.com';
#   # opsional fallback jika SSO_REALM_URL kosong:
#   SSO_BASE_URL          = https://sso.iccn.or.id
#   SSO_REALM             = PORTALICCN
#
# --- Payment Gateway (Xendit) ---
#   XENDIT_SECRET_KEY     = <Xendit Dashboard -> Developers -> API Keys>
#   XENDIT_WEBHOOK_TOKEN  = <Xendit Dashboard -> Developers -> Callback Tokens>
#
# --- Email Notifikasi ---
#   NOTIFICATION_EMAIL    = <email default penerima notifikasi admin>
#   # Gmail connector (Lovable Cloud): GOOGLE_MAIL_API_KEY dikelola otomatis.
#   # Self-hosted: gunakan SMTP (lihat VPS-SETUP-GUIDE.md -> "Email di self-host")
#   # RESEND_API_KEY (legacy, tidak dipakai sejak Mei 2026)
#
# --- Google Drive backup (Lovable Cloud) ---
#   # GOOGLE_DRIVE_API_KEY dikelola otomatis oleh connector.
#   # Self-hosted: gunakan service-account JSON, lihat backup-storage-to-drive.
#
# --- Google Cloud Storage (Media Library) ---
#   GCS_PROJECT_ID           = <GCP project id>
#   GCS_BUCKET_NAME          = <nama bucket>
#   GCS_SERVICE_ACCOUNT_KEY  = <JSON service account, single line>
#
# --- Spotify (metadata artist) ---
#   SPOTIFY_CLIENT_ID
#   SPOTIFY_CLIENT_SECRET
#
# --- Analytics ---
#   GA4_MEASUREMENT_ID       = G-XXXXXXXXXX
#
# --- Lovable AI Gateway ---
#   LOVABLE_API_KEY          = <managed di Lovable Cloud; TIDAK tersedia di self-host>
#   # Self-hosted alternatif: pakai key OpenAI/Anthropic/Gemini sendiri
#   # dan sesuaikan edge function yang memanggilnya.
# =============================================================