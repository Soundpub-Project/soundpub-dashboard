# .env.example - Soundpub Dashboard

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Verify the controlled public origin before setting this value.
VITE_SUPABASE_URL=https://your-controlled-supabase-host.example
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
VITE_DATABASE_SCHEMA=your-schema-name
VITE_PDF_SERVICE_URL=https://your-dashboard-host.example
VITE_CONTRACT_BUCKET=contracts
VITE_SSO_BASE_URL=https://sso.example.org
VITE_SSO_REALM=your-realm
VITE_SSO_CLIENT_ID=your-frontend-client-id
VITE_SSO_AUTO_REDIRECT=false
VITE_GA4_MEASUREMENT_ID=

# Phase 3 local-only domain adapter. Backend identity remains development-only until Phase 4.
# Leave empty for same-origin /api routing; Vite proxies local development to backend port 3000.
VITE_SOUNDPUB_API_URL=
VITE_SOUNDPUB_BACKEND_DOMAINS=

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Direct PostgreSQL Connection (for migrations)
DATABASE_URL=postgresql://postgres:your-password@your-controlled-database-host.example:5432/Soundpub
DB_HOST=your-controlled-database-host.example
DB_PORT=5432
DB_NAME=Soundpub
DB_USER=postgres
DB_PASSWORD=your-password-here
DB_SCHEMA=Soundpub

# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV=development
VITE_ENV=local

# ============================================
# NOTES
# ============================================
# - Resolve production routing ownership before configuring public origins.
# - Primary schema: Soundpub (core business logic)
# - Public schema: shared utilities (notifications, etc.)
# - For production, update these values accordingly
