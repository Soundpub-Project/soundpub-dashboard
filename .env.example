# .env.example - SoundPub Dashboard

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Supabase Local Instance
VITE_SUPABASE_URL=https://supabase.carubra.com
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Direct PostgreSQL Connection (for migrations)
DATABASE_URL=postgresql://postgres:your-password@supabase.carubra.com:5432/soundpub
DB_HOST=supabase.carubra.com
DB_PORT=5432
DB_NAME=soundpub
DB_USER=postgres
DB_PASSWORD=your-password-here
DB_SCHEMA=soundpub

# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV=development
VITE_ENV=local

# ============================================
# NOTES
# ============================================
# - This project uses Supabase Local at https://supabase.carubra.com
# - Primary schema: soundpub (core business logic)
# - Public schema: shared utilities (notifications, etc.)
# - For production, update these values accordingly
