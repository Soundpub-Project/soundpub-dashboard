# =============================================================
# SoundPub Dashboard - Environment Variables Example
# =============================================================
# File ini hanya REFERENSI / DOKUMENTASI.
#
# Lovable mengelola file `.env` aktual secara OTOMATIS untuk
# variable VITE_SUPABASE_*. JANGAN edit `.env` manual.
#
# Untuk menambah variable VITE_SSO_* (atau VITE_* lain) yang
# dibutuhkan saat build di production / preview, tambahkan di:
#   Workspace Settings -> Build Secrets
#
# Untuk secret backend (Edge Function), gunakan Cloud Secrets
# (lihat bagian bawah file ini).
# =============================================================


# -------------------------------------------------------------
# 1) Supabase / Lovable Cloud (auto-generated by Lovable)
# -------------------------------------------------------------
VITE_SUPABASE_PROJECT_ID="opkvvdgnhhopkkeaokzo"
VITE_SUPABASE_URL="https://opkvvdgnhhopkkeaokzo.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<auto-generated-by-lovable>"


# -------------------------------------------------------------
# 2) SSO ICCN (Frontend - dipakai oleh keycloak-js)
# -------------------------------------------------------------
# Base URL Keycloak ICCN (tanpa trailing slash)
VITE_SSO_BASE_URL="https://sso.iccn.or.id"

# Realm Keycloak
#   Staging    : playground
#   Production : PORTALICCN
VITE_SSO_REALM="playground"

# Client ID yang terdaftar di Keycloak ICCN untuk aplikasi ini
VITE_SSO_CLIENT_ID="soundpub"

# Auto-redirect ke halaman login ICCN jika silent SSO check gagal
# dan user belum login. Cocok untuk production di mana SoundPub
# memang khusus user ICCN.
#   true  = user yang belum login langsung di-redirect ke ICCN
#   false = user tetap melihat halaman login lokal (default)
VITE_SSO_AUTO_REDIRECT="false"

# CATATAN PENTING:
# ICCN/Keycloak mengembalikan callback (code & state) lewat URL fragment
# (mis. /auth#code=...&state=...), BUKAN query string. Aplikasi sudah
# mendeteksi keduanya. Jangan ubah `redirect_uri` ke path selain
# `${origin}/auth` agar sesuai konfigurasi client di Keycloak ICCN.


# -------------------------------------------------------------
# 3) Google Analytics 4 (opsional - frontend)
# -------------------------------------------------------------
# VITE_GA4_MEASUREMENT_ID="G-XXXXXXXXXX"


# =============================================================
# CLOUD SECRETS (Backend - Edge Functions)
# =============================================================
# Variable di bawah ini TIDAK disimpan di .env.
# Set lewat: Lovable -> Cloud -> Secrets
#
# SSO ICCN (backend verification)
#   SSO_REALM_URL          = https://sso.iccn.or.id/realms/playground
#                            (production: .../realms/PORTALICCN)
#   SSO_CLIENT_ID          = soundpub
#   ICCN_MEDIA_LABEL_ID    = <UUID label "ICCN Media" di tabel profiles>
#
# Payment Gateway (Xendit)
#   XENDIT_SECRET_KEY      = <dari dashboard Xendit>
#   XENDIT_WEBHOOK_TOKEN   = <dari dashboard Xendit>
#
# Email (Resend)
#   RESEND_API_KEY         = <dari dashboard Resend>
#   NOTIFICATION_EMAIL     = <email pengirim default>
#
# Google Cloud Storage (media library)
#   GCS_PROJECT_ID         = <GCP project id>
#   GCS_BUCKET_NAME        = <nama bucket>
#   GCS_SERVICE_ACCOUNT_KEY= <JSON service account, satu baris>
#
# Analytics
#   GA4_MEASUREMENT_ID     = G-XXXXXXXXXX
#
# AI Gateway (managed otomatis oleh Lovable)
#   LOVABLE_API_KEY        = <managed - jangan edit manual>
# =============================================================