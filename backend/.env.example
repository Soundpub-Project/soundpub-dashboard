# Isolated development/test only. Compose sets HOST=0.0.0.0 inside containers.
COMPOSE_PROJECT_NAME=dashboard-sounpub-dev
SOUNDPUB_DEV_API_PORT=3300
SOUNDPUB_DEV_POSTGRES_PORT=55433
SOUNDPUB_DEV_STORAGE_PORT=9100
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=
RECONCILIATION_DATABASE_URL=
AUDIT_DATABASE_URL=
LOG_LEVEL=info
DEV_AUTH_TOKENS_JSON={}
# Identity provider: mock/supabase-legacy only for isolated dev; oidc supports Keycloak partner bearer tokens.
IDENTITY_PROVIDER=mock
LEGACY_AUTH_URL=
LEGACY_AUTH_API_KEY=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
# Required for Keycloak partner access-token authorization (azp and client roles).
OIDC_CLIENT_ID=
# Existing backend label/whitelabel UUID that owns verified partner artists.
PARTNER_LABEL_ID=
OBJECT_STORAGE_ENDPOINT=object-storage
OBJECT_STORAGE_PORT=9000
OBJECT_STORAGE_USE_SSL=false
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=soundpub-development
WEBHOOK_MOCK_SECRET=
AUTH_DELIVERY_SECRET=
WORKER_POLL_MS=1000
WORKER_BATCH_SIZE=10
FINANCE_RECONCILIATION_INTERVAL_MS=300000
FINANCE_RECONCILIATION_ISSUE_LIMIT=500
FINANCE_RECONCILIATION_TIMEOUT_MS=5000
STORAGE_MAX_BYTES=10485760
# Compose creates soundpub_dev, non-superuser soundpub_owner and non-superuser soundpub_app. Passwords must be URL-safe (e.g. random hex).
POSTGRES_PASSWORD=
MIGRATION_DATABASE_PASSWORD=
APP_DATABASE_PASSWORD=
RECONCILIATION_DATABASE_PASSWORD=
AUDIT_DATABASE_PASSWORD=
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:9100
OBJECT_STORAGE_BROWSER_ORIGINS=http://127.0.0.1:8281,http://localhost:8281

