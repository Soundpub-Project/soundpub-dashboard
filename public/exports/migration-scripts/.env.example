# SoundPub Dashboard - Migration Script Configuration
# Copy this file to .env and fill in the values

# Source Supabase (Lovable Cloud)
SOURCE_SUPABASE_URL=https://your-source-project.supabase.co
SOURCE_SUPABASE_SERVICE_KEY=your-source-service-role-key

# Target Supabase (External)
TARGET_SUPABASE_URL=https://your-target-project.supabase.co
TARGET_SUPABASE_SERVICE_KEY=your-target-service-role-key
