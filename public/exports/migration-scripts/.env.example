# SoundPub Dashboard - Migration Script Configuration
# Copy this file to .env and fill in the values

# Target Supabase (Server Anda)
TARGET_SUPABASE_URL=https://your-target-project.supabase.co
TARGET_SUPABASE_SERVICE_KEY=your-target-service-role-key

# Schema tujuan di database target.
# Sejak v2.5 semua tabel dipindah dari `public` ke `soundpub-dashboard`.
TARGET_DB_SCHEMA=soundpub-dashboard

# Schema sumber (Lovable Cloud masih memakai `public`)
SOURCE_DB_SCHEMA=public

# Directory berisi CSV files hasil export dari Lovable
CSV_IMPORT_DIR=./exported-data/
